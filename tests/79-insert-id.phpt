<?php declare(strict_types=1); ?>
--TEST--
ID of an inserted row from an identity column found by Discovery
--FILE--
<?php
require_once __DIR__ . "/connect.inc.php";

$id = match ($driver) {
	"mysql" => "int NOT NULL AUTO_INCREMENT",
	"sqlite" => "integer NOT NULL", // an alias of rowid
	"pgsql" => "serial",
	"sqlsrv" => "int IDENTITY",
	"oci" => "int GENERATED BY DEFAULT AS IDENTITY",
};
$connection->exec("CREATE TABLE inserted (id $id, name varchar(20) NOT NULL, PRIMARY KEY (id))");
$discovery = new NotORM\NotORM($connection, new NotORM\Structure\Discovery($connection));
echo $discovery->inserted()->insert(["name" => "first"])["id"] . "\n";
echo $discovery->inserted()->insert(["name" => "second"])["id"] . "\n";
$connection->exec("DROP TABLE inserted");
?>
--EXPECTF--
1
2
