# https://editorconfig.org/
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{php,phpt,xml,neon,json}]
indent_style = tab

[*.yml]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
trim_trailing_whitespace = false
max_line_length = 120
